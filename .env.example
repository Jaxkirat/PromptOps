# ============================================================
# CodeForge configuration
# Copy this file to .env and fill in the values for the
# provider you want to use. Only the selected provider's
# credentials are required.
# ============================================================

# LLM Provider: openai | anthropic | google
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini

# Generic credentials (used first if set, regardless of provider)
LLM_API_KEY=
LLM_BASE_URL=

# Optional provider-specific configurations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Execution
EXECUTION_TIMEOUT_SECONDS=15
MAX_TEST_OUTPUT_LENGTH=10000

# ============================================================
# Phase 2 (R1): Identity, Privacy, API
# ============================================================

# JWT authentication (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./codeforge.db

# Quotas
MAX_RUNS_PER_USER_PER_DAY=20

# API server
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:7860

# Instructor provisioning (trusted server-side; leave empty to skip)
INITIAL_INSTRUCTOR_EMAIL=
INITIAL_INSTRUCTOR_PASSWORD=
INITIAL_INSTRUCTOR_NAME=

# Phase 3: Gradio workspace + instructor invitations
APP_BASE_URL=http://127.0.0.1:8000
INVITE_EXPIRY_HOURS=72

# ============================================================
# Phase 4 (R2): policy, approval, sandbox
# ============================================================
# Runs policy-allow code with a timeout in a temp directory.
# It is not a network or filesystem sandbox. File and network code is refused.
CODEFORGE_SANDBOX_BACKEND=restricted-process
CODEFORGE_SANDBOX_IMAGE=codeforge-sandbox:latest
CODEFORGE_SANDBOX_TIMEOUT_SECONDS=10
CODEFORGE_SANDBOX_MEMORY_MB=256
CODEFORGE_SANDBOX_CPU_LIMIT=1
CODEFORGE_SANDBOX_PIDS_LIMIT=32
CODEFORGE_SANDBOX_MAX_OUTPUT_BYTES=1048576
APPROVAL_EXPIRY_MINUTES=60
CODEFORGE_CHECKPOINT_PATH=./codeforge_checkpoints.sqlite

# ============================================================
# R7: read-only SQL agent
# ============================================================
# fixture proposes SQL without a live model. live uses LLM_* and still cannot
# skip validation. The application database is never opened for model SQL.
CODEFORGE_SQL_AGENT_ENABLED=true
CODEFORGE_SQL_MAX_ROWS=500
CODEFORGE_SQL_DEFAULT_LIMIT=100
CODEFORGE_SQL_TIMEOUT_SECONDS=2
CODEFORGE_SQL_MAX_RESULT_BYTES=200000
CODEFORGE_SQL_MAX_COLUMNS=16
CODEFORGE_SQL_DIALECT=sqlite
CODEFORGE_SQL_SAMPLE_DATABASE=./data/r7_sample.sqlite
CODEFORGE_SQL_PROPOSER=fixture

# R4 cascade. Leave blank to keep every agent on LLM_MODEL.
LLM_MODEL_SMALL=
LLM_MODEL_LARGE=

# R5 resilience. Placeholders only. Chaos cannot turn on when APP_ENV=production.
PRIMARY_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=
FALLBACK_1_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
FALLBACK_2_PROVIDER=
FALLBACK_2_API_KEY=
FALLBACK_2_MODEL=
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.5
LLM_RETRY_MAX_DELAY=8
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_COOLDOWN=30
CODEFORGE_CHAOS_ENABLED=false
CODEFORGE_CHAOS_FAILURE_RATE=0.60

